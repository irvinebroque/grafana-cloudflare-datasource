{
  "uid": "cloudflare-overview",
  "title": "Cloudflare overview",
  "schemaVersion": 41,
  "version": 1,
  "tags": ["cloudflare", "workers"],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Worker requests / s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "format": "timeseries",
          "limit": 10000,
          "queryType": "sql",
          "params": "{\"selectedWorker\":\"${worker:raw}\"}",
          "sql": "SELECT $__timeGroup(timestamp) AS time, scriptName, COUNT(*) / $__interval_s AS requestsPerSecond FROM events.workersInvocations WHERE scriptName LIKE $selectedWorker GROUP BY time, scriptName ORDER BY time LIMIT 10000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Worker invocations per second, grouped by Worker. Counts include Cloudflare adaptive sampling weights."
    },
    {
      "id": 8,
      "title": "Worker request duration · p95",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "queryType": "builder",
          "format": "timeseries",
          "dataset": "events.workersInvocations",
          "metrics": [
            {
              "aggregation": "p95",
              "field": "requestDurationUs",
              "alias": "requestDurationUs"
            }
          ],
          "groupBy": ["scriptName"],
          "filters": [
            {
              "field": "scriptName",
              "operator": "LIKE",
              "value": "$worker"
            },
            {
              "field": "requestDurationUs",
              "operator": ">",
              "value": "0"
            }
          ],
          "limit": 10000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Time from the first request byte received to the last response byte sent. Excludes invocations without a recorded request duration; quantiles use sampling weights."
    },
    {
      "id": 2,
      "title": "Worker CPU · p99",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "queryType": "builder",
          "format": "timeseries",
          "dataset": "events.workersInvocations",
          "metrics": [
            {
              "aggregation": "p99",
              "field": "cpuTimeUs",
              "alias": "cpuTimeUs"
            }
          ],
          "groupBy": ["scriptName"],
          "filters": [
            {
              "field": "scriptName",
              "operator": "LIKE",
              "value": "$worker"
            }
          ],
          "limit": 10000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Worker errors · %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "format": "timeseries",
          "limit": 10000,
          "queryType": "sql",
          "params": "{\"selectedWorker\":\"${worker:raw}\"}",
          "sql": "SELECT $__timeGroup(timestamp) AS time, 100.0 * countIf(status IN ('scriptThrewException', 'exceededResources', 'internalError')) / COUNT(*) AS invocationFailurePct FROM events.workersInvocations WHERE scriptName LIKE $selectedWorker GROUP BY time ORDER BY time LIMIT 10000"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "format": "timeseries",
          "limit": 10000,
          "queryType": "sql",
          "params": "{\"selectedWorker\":\"${worker:raw}\"}",
          "sql": "SELECT $__timeGroup(timestamp) AS time, 100.0 * countIf(httpResponseStatus >= 500) / COUNT(*) AS http5xxPct FROM events.workersInvocations WHERE scriptName LIKE $selectedWorker AND httpResponseStatus >= 100 AND httpResponseStatus < 600 GROUP BY time ORDER BY time LIMIT 10000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "invocationFailurePct"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Invocation failures"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http5xxPct"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "HTTP 5xx"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Invocation failures: exceptions, resource-limit failures, and internal errors as a percentage of all invocations. HTTP 5xx: server-error responses as a percentage of recorded HTTP responses. No recorded HTTP responses produces a gap."
    },
    {
      "id": 4,
      "title": "D1 query latency · account",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "queryType": "builder",
          "format": "timeseries",
          "dataset": "events.d1Queries",
          "metrics": [
            {
              "aggregation": "avg",
              "field": "queryDurationMs",
              "alias": "queryDurationMs"
            }
          ],
          "groupBy": [],
          "filters": [],
          "limit": 10000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Account-wide data. The Worker selector does not filter this panel."
    },
    {
      "id": 5,
      "title": "R2 operations · account",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "queryType": "builder",
          "format": "timeseries",
          "dataset": "events.r2CombinedOperations",
          "metrics": [
            {
              "aggregation": "count",
              "field": "",
              "alias": "requests"
            }
          ],
          "groupBy": [],
          "filters": [],
          "limit": 10000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Account-wide data. The Worker selector does not filter this panel."
    },
    {
      "id": 6,
      "title": "Worker logs · open a trace from log details",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "queryType": "builder",
          "format": "logs",
          "dataset": "logs.workersLogs",
          "filters": [
            {
              "field": "scriptName",
              "operator": "LIKE",
              "value": "$worker"
            }
          ],
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Recent traces · click a trace ID to inspect",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "cloudflare-cloudflare-datasource",
        "uid": "${DS_CLOUDFLARE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudflare-cloudflare-datasource",
            "uid": "${DS_CLOUDFLARE}"
          },
          "queryType": "builder",
          "format": "traces",
          "dataset": "logs.traces",
          "limit": 30,
          "filters": [
            {
              "field": "serviceName",
              "operator": "LIKE",
              "value": "$worker"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Traces containing spans from the selected Worker service. Open a trace to inspect all its retained spans."
    }
  ],
  "templating": {
    "list": [
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": {
          "type": "cloudflare-cloudflare-datasource",
          "uid": "${DS_CLOUDFLARE}"
        },
        "query": {
          "refId": "VariableQuery",
          "queryType": "sql",
          "format": "table",
          "sql": "SELECT scriptName AS __text, scriptName AS __value FROM events.workersInvocations GROUP BY scriptName LIMIT 1000"
        },
        "definition": "Workers in the current dashboard range",
        "refresh": 2,
        "includeAll": true,
        "allValue": "%",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "description": "Filters Worker metrics, logs, traces, and annotations. D1 and R2 panels show account-wide data."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Worker errors",
        "enable": false,
        "hide": false,
        "datasource": {
          "type": "cloudflare-cloudflare-datasource",
          "uid": "${DS_CLOUDFLARE}"
        },
        "iconColor": "red",
        "target": {
          "refId": "Annotations",
          "queryType": "sql",
          "format": "table",
          "sql": "SELECT timestamp AS time, message AS text FROM logs.workersLogs WHERE level = 'error' AND scriptName LIKE $selectedWorker ORDER BY timestamp DESC LIMIT 20",
          "params": "{\"selectedWorker\":\"${worker:raw}\"}"
        }
      },
      {
        "name": "Worker deployments (select a Worker)",
        "enable": false,
        "hide": false,
        "datasource": {
          "type": "cloudflare-cloudflare-datasource",
          "uid": "${DS_CLOUDFLARE}"
        },
        "iconColor": "#5794F2",
        "target": {
          "refId": "Deployments",
          "queryType": "rest",
          "format": "table",
          "operation": "worker-deployments",
          "resourceId": "$worker",
          "limit": 1000
        },
        "mappings": {
          "time": {
            "source": "field",
            "value": "created_on"
          },
          "text": {
            "source": "field",
            "value": "id"
          },
          "title": {
            "source": "field",
            "value": "source"
          }
        }
      }
    ]
  },
  "__inputs": [
    {
      "name": "DS_CLOUDFLARE",
      "label": "Cloudflare",
      "type": "datasource",
      "pluginId": "cloudflare-cloudflare-datasource",
      "pluginName": "Cloudflare"
    }
  ],
  "links": [
    {
      "title": "Cloudflare traces",
      "url": "/d/cloudflare-traces/cloudflare-traces",
      "type": "link",
      "keepTime": true
    }
  ]
}
